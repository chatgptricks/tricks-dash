{
  "name": "tricks-dash",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "npm run test:product && npm run test:queue && npm run test:resilience && npm run test:users && npm run smoke:queue && npm run smoke:settings && npm run smoke:mobile && npm run smoke:roles && npm run smoke:hooks && node smoke/static-pages.mjs && node smoke/tracker.mjs && node smoke/insights-extras.mjs && node smoke/sign-in.mjs",
    "test:product": "node scripts/test-topics.mjs && node smoke/run-product.mjs",
    "test:queue": "node scripts/test-queue.mjs",
    "test:resilience": "node scripts/test-retry.mjs && node scripts/test-api-resilience.mjs",
    "test:users": "node scripts/test-user-admin.mjs",
    "smoke:queue": "node smoke/run-queue.mjs",
    "smoke:settings": "node smoke/run-settings.mjs",
    "smoke:mobile": "node scripts/test-mobile-routing.mjs && node smoke/run-mobile.mjs",
    "smoke:roles": "node smoke/roles.mjs",
    "smoke:vault": "node smoke/run-vault.mjs && node smoke/run-vault.mjs admin && node smoke/run-vault.mjs preview",
    "smoke:hooks": "node smoke/run-hooks.mjs && node smoke/run-hooks.mjs admin",
    "smoke:visual": "node smoke/visual-release.mjs"
  },
  "dependencies": {
    "firebase": "^12.19.0",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "playwright": "^1.63.0",
    "vite": "^8.3.1"
  }
}
